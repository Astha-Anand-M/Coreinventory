# ==============================================================================
# Core Inventory Management System - Environment Configuration
# ==============================================================================

# Application Environment (development / production)
APP_ENV=development
APP_NAME="Core Inventory"

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# For Local Development (XAMPP):
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=core_inventory
DB_USER=root
DB_PASSWORD=

# For Production (Railway MySQL):
# When deploying to Railway, Railway provides these variables automatically:
# MYSQLHOST=viaduct.proxy.rlwy.net
# MYSQLPORT=48215
# MYSQLDATABASE=railway
# MYSQLUSER=root
# MYSQLPASSWORD=your_railway_password
# Or a single connection URL:
# DATABASE_URL=mysql://root:password@viaduct.proxy.rlwy.net:48215/railway
